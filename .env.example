DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# CORS allowlist for direct cross-origin browser calls to the API.
# Comma-separated origins; wildcard subdomain patterns are supported
# (see server/src/app.ts). localhost is always allowed implicitly.
CORS_ALLOWED_ORIGINS=https://*.aiotnetwork.io,https://*.uni-ai.io
